{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xenon repository module package index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "moduleId", "moduleVersion", "files"],
  "properties": {
    "schema": { "const": "xenon.repository-package" },
    "version": { "const": 1 },
    "moduleId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "moduleVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "size": { "type": "integer", "minimum": 0, "maximum": 134217728 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
