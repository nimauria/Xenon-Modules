{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nimauria/Xenon-Modules/schema/catalog.schema.json",
  "title": "Xenon Module Catalog",
  "description": "Schema for the Xenon public module registry catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "modules"
  ],
  "properties": {
    "schema": {
      "const": "xenon.module-catalog"
    },
    "version": {
      "const": 2
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^games/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]*/entry\\.json$"
      },
      "maxItems": 256
    }
  }
}
