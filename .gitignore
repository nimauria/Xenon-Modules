# Personal artwork, game content and local workspace state.
/.local/
/local-content/
/node_modules/

# Shared development build outputs; never apply these rules to games/.
/development/**/build/
/development/**/out/
/development/**/dist/
/development/**/generated/
/development/**/.cache/
/development/**/__pycache__/
/development/**/.vs/
/development/**/.vscode/
/development/**/.idea/
/development/**/game-data/
/development/**/private/
/development/**/scratch/
/development/**/runtime/**/session/
/development/**/runtime/**/screenshots/
/development/**/runtime/**/saves/
/development/**/*.dll
/development/**/*.exe
/development/**/*.pdb
/development/**/*.obj

# Imported ignore rules: development/nimauria/project-gracemeria
/development/nimauria/project-gracemeria/**/build/
/development/nimauria/project-gracemeria/**/out/
/development/nimauria/project-gracemeria/**/dist/
/development/nimauria/project-gracemeria/**/generated/
